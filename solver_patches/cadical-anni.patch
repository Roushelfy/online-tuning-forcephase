 namespace CaDiCaL {
 
+// anni patch: one machine-readable telemetry line; prints to stdout like other 'c' lines.
+void Internal::anni_report (const char *tag) {
+  const double t = process_time ();
+  if (opts.anniprobe) anni_next_report = t + opts.anniprobe / 1000.0;
+  printf ("c anni %s t=%.4f conflicts=%" PRId64 " decisions=%" PRId64 " propagations=%" PRId64
+          " restarts=%" PRId64 " reductions=%" PRId64 " rephased=%" PRId64 " chrono=%" PRId64
+          " stable=%d stabphases=%" PRId64 " fixed=%" PRId64 " learned_lits=%" PRId64
+          " learned_cls=%" PRId64 " irredundant=%" PRId64 " redundant=%" PRId64 " active=%d"
+          " level_ema=%.4f jump_ema=%.4f trail_fast=%.4f trail_slow=%.4f glue_fast=%.4f"
+          " glue_slow=%.4f size_ema=%.4f decision_rate_ema=%.4f sum_conflict_level=%" PRId64
+          " sum_backtrack_level=%" PRId64 " sum_jump=%" PRId64 " samples=%" PRId64 "\n",
+          tag, t, stats.conflicts, stats.decisions, stats.propagations.search, stats.restarts,
+          stats.reductions, stats.rephased.total, stats.chrono, (int) stable, stats.stabphases,
+          stats.all.fixed, stats.learned.literals, stats.learned.clauses, stats.current.irredundant,
+          stats.current.redundant, active (), (double) averages.current.level,
+          (double) averages.current.jump, (double) averages.current.trail.fast,
+          (double) averages.current.trail.slow, (double) averages.current.glue.fast,
+          (double) averages.current.glue.slow, (double) averages.current.size,
+          (double) averages.current.decisions, anni_sum_conflict_level, anni_sum_backtrack_level,
+          anni_sum_jump, anni_samples);
+  fflush (stdout);
+}
