{
  "schema_version": 1,
  "phase": "online_selection_v9",
  "protocol_doc": "docs/ONLINE_SELECTION_PROTOCOL_V9.md",
  "resource_policy": "configs/resource_policy.json",
  "metric": "mean_completed_cpu_seconds",
  "solver": {"commit": "c60730422e758ef1cebe7aeddf2dda31c996bf04", "binary": "build/fpc/cadical",
             "binary_sha256": "6cf084699e872250ffa4d9a186d8ad7fe3829d06fc2d898294f2ac5e989ba884",
             "run_policy": ["--lrat=1", "<action>", "--fpc=1"], "seed": 0, "mem_mb": 16000,
             "actions": {"D": ["--phase=1", "--forcephase=0"], "Fp": ["--phase=1", "--forcephase=1"],
                         "Fm": ["--phase=0", "--forcephase=1"]},
             "mechanism_configs": {"D_R0": ["--phase=1", "--forcephase=0", "--rephase=0"], "D_P0": ["--phase=0", "--forcephase=0"],
                                   "D_R0_P0": ["--phase=0", "--forcephase=0", "--rephase=0"]}},
  "probe": {"command": "the formal D command", "window": "probe process CPU from start, SIGTERM at tau, SIGKILL 1 s later",
            "answer_reuse": true, "unsolved": "restart chosen action from the original input, repeated work charged",
            "features": "last telemetry checkpoint written before the stop; none -> missing"},
  "type_index": {"rand3": 0, "col3": 1, "assign2": 2, "assign0": 3},
  "scale_index": {"S": 0, "M": 1, "L": 2},
  "pilot": {
    "seed_rule": "9000000 + 1000*round + 100*type_index + 10*scale_index + replicate",
    "round1": {"rand3": {"S": 260, "M": 300, "L": 350}, "col3": {"S": 400, "M": 500, "L": 550}, "replicates": 4,
               "assign2": {"structures": ["A", "B", "C"], "T": [100, 200], "replicates": 2}},
    "round2_assign2_replicates": 4,
    "decision_when": "every pilot run complete or above 600 CPU s (counted as >= 600; runs continue)",
    "cost_statistic": "mean CPU of D, Fp, Fm",
    "targets_cpu_seconds": {"S": 2.0, "M": 10.0, "L": 40.0},
    "bands_cpu_seconds": {"S": [1, 5], "M": [5, 30], "L": [30, 120]},
    "keep_v8_if_median_within": "[band_low/5, band_high*5]",
    "assign2_structure_rule": ["count of round-1 instances with c in [1,600] s and D conflicts >= 1e4 (max)", "both SAT and UNSAT present", "median log c closest to log 10", "order A, B, C"],
    "assign2_scale_rule": "log c vs log T through the two round-1 medians of the chosen structure; T at c = 2/10/40 s snapped to the grid, strictly increasing; non-positive slope -> 150/250/400",
    "assign2_fallback_scales": {"S": 150, "M": 250, "L": 400}
  },
  "formal": {
    "main_seed_rule": "9100000 + 10000*type_index + 1000*scale_index + j, j = 0..59",
    "split_rule": "within a cell sort ids by sha256(id + ':v9split'): ranks 0-29 dev, 30-39 H1, 40-49 H2, 50-59 H3",
    "controls": {"type": "assign0", "T": {"S": 400, "M": 500, "L": 600}, "per_scale": 10, "dev": 5, "holdout": 5,
                 "seed_rule": "9200000 + 1000*scale_index + j"},
    "extrapolation": {"rand3": [375, 400], "col3": [575, 600], "assign2": ["1.2*T_L", "1.4*T_L"], "per_level": 15,
                      "seed_rule": "9300000 + 10000*type_index + 1000*level + j"},
    "duplicate_checks": ["sha256", "canonical_sha256", "invariant_sha256"],
    "queue_order": "scales L, M, S; types rand3, col3, assign2, assign0; split hash; configurations of one instance adjacent"
  },
  "external": {"source": "SATLIB", "fixed_after_main_strategy_freeze": true,
               "selection": {"uf250-1065": 8, "uuf250-1065": 7, "flat200-479": 15, "sw100-8": 15,
                             "structured": ["bw_large.a-d", "logistics.a-d", "qg1-qg7"]}},
  "selection": {
    "tau_grid": [0.1, 0.25, 0.5, 1, 2, 5, 10],
    "fallbacks": ["Fp", "Fm"],
    "reference": {"kind": "presolve", "tau": 2, "fallback": "Fp"},
    "gate_features": {"scale": ["s_log_vars", "s_log_clauses", "s_cv_ratio"],
                      "content": ["s_bin_frac", "s_pos_frac", "r_log_conflicts", "c_dec_per_conf", "c_props_per_dec",
                                  "c_glue_mean", "x_trail_frac", "x_best_frac", "x_saved_neg_frac"]},
    "tree": {"max_depth": 2, "threshold_quantiles": [0.25, 0.5, 0.75], "min_leaf": 5, "margin_seconds": [0, 5, 20]},
    "ridge": {"alpha": [1, 10, 100], "margin_seconds": [0, 5, 20]},
    "outer_folds": 5, "inner_folds": 3,
    "fold_rule": "within a cell rank by split hash; outer fold = rank mod 5; inner fold = rank within the training part mod 3",
    "main_rule": "B if outer-CV total < A total * 0.99; else A if < SBS total * 0.99; else SBS",
    "max_deployed_wrappers": 2
  },
  "validation": {"primary": ["W_main vs D", "W_main vs SBS"], "secondary": ["W_ref vs D", "W_ref vs SBS"],
                 "bootstrap": "paired, instances resampled within the 9 cells, 10000 resamples, seed 0, 95% percentile",
                 "practical_target_percent": 5, "reliable_if": "95% lower bound > 0",
                 "blocks": ["H1", "H2", "H3"]},
  "robustness": {"instances": "6 per cell, smallest split-hash ranks among dev", "seed1": ["D", "Fp", "Fm"],
                 "perm1": ["D", "Fp", "Fm", "W_main", "W_ref"]},
  "mechanism": {"instances": "6 per dev cell: 3 SAT + 3 UNSAT by split-hash order (fill with the other answer if short)",
                "configs": ["D", "D_R0", "D_P0", "D_R0_P0", "Fp", "Fm"]},
  "platform": {"proof_disk_guard_gb": 300}
}
