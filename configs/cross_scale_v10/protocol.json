{
 "schema_version": 1,
 "protocol": "docs/CROSS_SCALE_PROTOCOL_V10.md",
 "solver": {"binary": "build/fpc/cadical", "args": "--lrat=1 <action> --fpc=1", "seed": 0, "mem_mb": 16000,
            "actions": {"D": "--phase=1 --forcephase=0", "Fp": "--phase=1 --forcephase=1", "Fm": "--phase=0 --forcephase=1"}},
 "per_run_cpu_seconds": 3600,
 "types": ["rand3", "col3", "assign2"],
 "assign2_structure": "F",
 "levels": {"dev": ["S", "M", "L"], "extrapolation": ["X"]},
 "pilot": {"per_level": 6, "methods": ["D"], "bands_geomean_D": {"S": [0.05, 2.0], "M": [0.5, 20.0], "L": [2.0, 200.0]},
           "targets": {"S": 0.3, "M": 3.0, "L": 30.0}, "x_max_pilot_D": 1200.0},
 "seeds": {"pilot": "10900000 + 1000*type_idx + 100*level_idx + j", "formal": "10000000 + 100000*type_idx + 10000*level_idx + j",
           "type_idx": {"rand3": 0, "col3": 1, "assign2": 2}, "level_idx": {"S": 0, "M": 1, "L": 2, "X": 3}},
 "split": {"hash": "sha256(id + ':v10split')", "dev_ranks": [0, 29], "H1": [30, 39], "H2": [40, 49], "H3": [50, 59],
           "outer_fold": "rank mod 5", "inner_fold": "rank among the training instances of the cell mod 3"},
 "measure": {"static": true, "probes": {"D": [0.1, 0.5, 2.0, 5.0], "Fp": [0.1, 0.5, 2.0], "Fm": [0.1, 0.5, 2.0]}},
 "static": {"tool": "build/tools/static10", "cpu_cap": 2.0, "work_cap": 5e7},
 "families": {
  "SBS": {"grid": {"action": ["D", "Fp", "Fm"]}},
  "A": {"features": "A", "taus": null},
  "N_B": {"taus": [0.1, 0.5, 2.0, 5.0], "fallback": ["D", "Fp", "Fm"]},
  "B_v9": {"features": "B_v9", "taus": [0.1, 0.5, 2.0, 5.0], "role": "fixed old baseline (reported, not a main candidate)"},
  "B": {"features": "B", "taus": [0.1, 0.5, 2.0, 5.0]},
  "N_C": {"taus": [0.1, 0.5, 2.0], "orders": [["D", "Fp", "Fm"], ["Fp", "Fm", "D"]], "fallback": ["D", "Fp", "Fm"]},
  "C": {"features": "C", "taus": [0.1, 0.5, 2.0], "orders": [["D", "Fp", "Fm"], ["Fp", "Fm", "D"]]}
 },
 "readers": {"ridge_alpha": [0.1, 1.0, 10.0], "tree_depth": [2, 3], "margin_seconds": [0.0, 0.1, 1.0],
             "tree_threshold_quantiles": [0.25, 0.5, 0.75], "tree_min_leaf": 5},
 "complexity_order": ["SBS", "A", "N_B", "B", "N_C", "C"],
 "main_candidates": ["SBS", "A", "N_B", "B", "N_C", "C"],
 "matched_control": {"A": "SBS", "B": "N_B", "B_v9": "N_B", "C": "N_C"},
 "replace_margin": 0.01,
 "fixed_reference": {"name": "REF_D2_Fp", "kind": "observe", "probes": [{"arm": "D", "tau": 2.0}], "base": "Fp"},
 "bootstrap": {"resamples": 10000, "seed": 0, "level": 0.95, "strata": "cell (type x level); external: family group"},
 "time_points": [1, 10, 60, 600, 3600],
 "clear_advantage": {"relative": 0.2, "absolute_seconds": 1.0},
 "practical_gain_target_vs_dev_sbs": 0.05
}
