diff --git a/src/analyze.cpp b/src/analyze.cpp
--- a/src/analyze.cpp
+++ b/src/analyze.cpp
@@ -1321,6 +1321,10 @@
   stats.binaries += (size == 2);
   UPDATE_AVERAGE (averages.current.size, size);
   fpcc.minsize_sum += size;
+  int fpc_lpos = 0; // observation build: positive literals learned
+  for (const auto &other : clause)
+    fpc_lpos += (other > 0);
+  fpcc.learn_lits += size, fpcc.learn_pos += fpc_lpos;
 
   // reverse lrat_chain. We could probably work with reversed iterators
   // (views) to be more efficient but we would have to distinguish in proof
@@ -1344,6 +1348,10 @@
   int new_level = determine_actual_backtrack_level (jump);
   UPDATE_AVERAGE (averages.current.level, new_level);
   fpcc.analyzed++, fpcc.backjump_sum += level - new_level;
+  if (new_level != jump) { // observation build: chronological backtrack
+    fpcc.bt_chrono++, fpcc.glue_chrono += glue;
+    fpcc.learn_lits_chrono += size, fpcc.learn_pos_chrono += fpc_lpos;
+  }
   backtrack (new_level);
 
   // It should hold that (!level <=> size == 1)
diff --git a/src/propagate.cpp b/src/propagate.cpp
